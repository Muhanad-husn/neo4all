# neo4all — environment variable template
# Copy this file to .env and fill in your values.
#
# Neo4j Aura downloads a .env file using NEO4J_URI / NEO4J_USERNAME / NEO4J_PASSWORD.
# The app also accepts those names as aliases for the canonical NEO4J_DEV_* names,
# so you can use either the Aura-generated file or rename to the canonical form.

# --- Neo4j Aura (dev instance) ---
# Canonical names (preferred):
NEO4J_DEV_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_DEV_USER=neo4j
NEO4J_DEV_PASSWORD=

# Neo4j Aura-generated aliases (also accepted):
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=

# --- Neo4j (CI — optional, integration tests skip if absent) ---
# NEO4J_CI_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_CI_USER=neo4j
# NEO4J_CI_PASSWORD=

# --- LLM gateway ---
OPENROUTER_API_KEY=

# --- Object storage (RustFS local / S3 prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=neo4all

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Qdrant (optional — omit to use local in-process) ---
# QDRANT_URL=http://localhost:6333

# --- Observability ---
LOG_FORMAT=console
LOG_LEVEL=INFO

# --- Ingestion parser toggles ---
ENABLE_DOCLING=true
ENABLE_UNSTRUCTURED=true
ENABLE_RAW_FALLBACK=true

# --- Embedding model ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Dry-run mode ---
DRY_RUN=false
