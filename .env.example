# neo4all — local development environment
# Generated from .env.example — DO NOT COMMIT

# --- Neo4j Aura (dev instance) ---
# Using Aura-generated alias names (also accepted by the app)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-aura-password-here

# --- LLM gateway ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Object storage (RustFS local) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=neo4all

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Observability ---
LOG_FORMAT=console
LOG_LEVEL=INFO

# --- Ingestion parser toggles ---
ENABLE_DOCLING=true
ENABLE_UNSTRUCTURED=true
ENABLE_RAW_FALLBACK=true

# --- Embedding model ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Dry-run mode ---
DRY_RUN=false
