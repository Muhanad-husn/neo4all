FROM python:3.12-slim

WORKDIR /app

# Install uv package manager
RUN pip install --no-cache-dir uv==0.5.21

# Copy project definition first (layer cache: deps change less than source)
COPY pyproject.toml README.md ./

# Copy API source (worker lives inside api/) and prompt templates
COPY api/ api/
COPY prompts/ prompts/

# Install CPU-only PyTorch first (saves ~2 GB vs default CUDA build)
RUN uv pip install --system --no-cache \
    torch torchvision --index-url https://download.pytorch.org/whl/cpu

# Install the package and all dependencies
RUN uv pip install --system --no-cache .

# Pre-download the embedding model so extraction doesn't stall on first use
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2')"

# Uses [project.scripts] entry point: api.worker.entry:run
CMD ["arq-worker"]
