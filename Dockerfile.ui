FROM python:3.12-slim

WORKDIR /app

# Install uv package manager
RUN pip install --no-cache-dir uv==0.5.21

# Copy project definition first (layer cache: deps change less than source)
COPY pyproject.toml README.md ./

# Copy UI source and API package (shared models may be imported)
COPY api/ api/
COPY ui/ ui/

# Install the package and all dependencies
RUN uv pip install --system --no-cache .

EXPOSE 8501

# Streamlit does not use a [project.scripts] entry point
CMD ["streamlit", "run", "ui/app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true"]
