FROM python:3.12-slim

WORKDIR /app

# Install uv package manager
RUN pip install --no-cache-dir uv==0.5.21

# Copy project definition first (layer cache: deps change less than source)
COPY pyproject.toml README.md ./

# Stub packages so `uv pip install .` resolves without source code
RUN mkdir -p api ui && touch api/__init__.py ui/__init__.py

# Install CPU-only PyTorch first (saves ~2 GB vs default CUDA build)
RUN uv pip install --system --no-cache \
    torch --index-url https://download.pytorch.org/whl/cpu

# Install dependencies (cached unless pyproject.toml changes)
RUN uv pip install --system --no-cache .

# NOW copy actual source code (cheap layer, no reinstall)
COPY api/ api/
COPY ui/ ui/
COPY streamlit_app.py ./
COPY .streamlit/ .streamlit/
COPY docs/light-mode-logo.png docs/dark-mode-logo.png docs/

EXPOSE 8501

# Streamlit does not use a [project.scripts] entry point.
# Run from repo root so auto-discovery finds no pages/ directory —
# st.navigation() in ui/app.py has sole control over routing.
CMD ["streamlit", "run", "streamlit_app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true"]
